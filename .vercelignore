# Exclude large files and directories from Vercel deployment
node_modules
.next
.git
*.log
*.tmp
*.temp
.env.local
.env.development.local
.env.test.local
.env.production.local

# Exclude development files
scripts/
scraped_rules/
*.ai
*.backup
*.md
*.txt
*.bat
*.js
*.sql

# Exclude test files (but not CSS files)
test-*
*test*.js
*test*.ts
*test*.json

# Exclude large data files
data/
database/
prisma/dev.db
