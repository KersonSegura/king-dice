{
  "crons": [
    {
      "path": "/api/cron/daily-chat-reset",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/weekly-canvas-snapshot",
      "schedule": "0 0 * * 0"
    }
  ],
  "functions": {
    "app/api/scraper/general/route.ts": {
      "maxDuration": 10
    },
    "app/api/scraper/v2/route.ts": {
      "maxDuration": 10
    },
    "app/api/scraper/ultraboardgames/route.ts": {
      "maxDuration": 10
    }
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "SKIP_ENV_VALIDATION": "true"
    }
  },
  "installCommand": "rm -rf node_modules && npm install",
  "buildCommand": "rm -rf .next node_modules/.prisma node_modules/@prisma/client/node_modules/.prisma && npx prisma generate --schema=./prisma/schema.prisma && npm run build"
}
