# Point the app at your local Next.js server so Chat/WebViews and sign-in work.
# Android emulator: 10.0.2.2 = host's localhost.
# Physical device (iPhone/Android on same Wi‑Fi): use your PC IP (run "npm run check-connection" in mobile-app for your IP).
# Use production API so registration sends verification emails from Vercel.
# For local dev, temporarily set to http://YOUR_LOCAL_IP:3000
EXPO_PUBLIC_API_URL=https://www.kingdice.gg
# For native Google Sign-In. Copy the value from GOOGLE_CLIENT_ID in your root .env (same Web OAuth client ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=404642348674-af8b9ihfidarjehmurp3tn14vkq2hr6f.apps.googleusercontent.com
