{
  "expo": {
    "name": "King Dice",
    "slug": "king-dice",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kingdice.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.kingdice.app",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "statusBar": {
        "translucent": true,
        "backgroundColor": "transparent"
      }
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "scheme": "kingdice",
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
